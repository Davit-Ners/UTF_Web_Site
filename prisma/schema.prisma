generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  apparel
  music
  accessories
}

enum ProductBadge {
  New
  Limited
  PreOrder @map("Pre-order")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  DISCONTINUED
}

enum InventoryMovementType {
  INITIAL_IMPORT
  MANUAL_ADJUSTMENT
  RESTOCK
  SALE
  RETURN
  CANCELLATION
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  PUBLIC_SITE
  INTERNAL_ADMIN
  MANUAL
}

enum ConcertStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum ConcertLineupRole {
  HEADLINER
  SUPPORT
  GUEST
}

enum ConcertImageKind {
  POSTER
  HERO
  GALLERY
}

enum BookingRequestStatus {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
  SPAM
  ARCHIVED
}

enum BookingRequestSource {
  PUBLIC_SITE
  INTERNAL_ADMIN
}

enum NewsletterSubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  slug               String?             @unique
  status             ProductStatus       @default(DRAFT)
  price              Float
  currency           String              @default("EUR")
  image              String?
  category           ProductCategory
  badge              ProductBadge?
  shortDesc          String?
  description        String?
  stock              Int?
  featured           Boolean             @default(false)
  sortOrder          Int                 @default(0)
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  variants           ProductVariant[]
  images             ProductImage[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@index([status, sortOrder])
  @@index([featured, status])
  @@map("product")
}

model ProductVariant {
  id                 String               @id @default(cuid())
  productId          String
  sku                String               @unique
  name               String
  size               String?
  color              String?
  price              Float?
  stock              Int?
  status             ProductVariantStatus @default(ACTIVE)
  isDefault          Boolean              @default(false)
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  product            Product              @relation(fields: [productId], references: [id])
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@index([productId, sortOrder])
  @@index([productId, status])
  @@map("product_variant")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  caption   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_image")
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  variantId     String?
  orderId       String?
  type          InventoryMovementType
  quantityDelta Int
  reason        String?
  reference     String?
  happenedAt    DateTime              @default(now())
  createdAt     DateTime              @default(now())
  product       Product               @relation(fields: [productId], references: [id])
  variant       ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order         CustomerOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, happenedAt])
  @@index([variantId, happenedAt])
  @@index([orderId])
  @@map("inventory_movement")
}

model CustomerOrder {
  id                 String              @id @default(cuid())
  orderNumber        String?             @unique
  status             OrderStatus         @default(DRAFT)
  source             OrderSource         @default(PUBLIC_SITE)
  currency           String              @default("EUR")
  subtotalAmount     Float
  shippingAmount     Float               @default(0)
  totalAmount        Float
  customerName       String?
  email              String
  phone              String?
  notes              String?
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingPostalCode String?
  shippingCity       String?
  shippingCountry    String?
  paidAt             DateTime?
  fulfilledAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@map("customer_order")
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  productId           String
  variantId           String?
  quantity            Int
  unitPrice           Float
  lineTotal           Float
  productNameSnapshot String
  variantNameSnapshot String?
  skuSnapshot         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  order               CustomerOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id])
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_item")
}

model Concert {
  id               String               @id @default(cuid())
  slug             String               @unique
  status           ConcertStatus        @default(DRAFT)
  title            String?
  subtitle         String?
  note             String?
  description      String?
  startsAt         DateTime
  doorsAt          DateTime?
  showAt           DateTime?
  timezone         String               @default("Europe/Brussels")
  venueName        String
  venueAddress     String?
  city             String
  region           String?
  postalCode       String?
  countryCode      String               @default("BE")
  ticketUrl        String?
  facebookEventUrl String?
  posterUrl        String?
  priceLabel       String?
  featured         Boolean              @default(false)
  publishedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  lineupEntries    ConcertLineupEntry[]
  images           ConcertImage[]

  @@index([status, startsAt])
  @@index([featured, startsAt])
  @@map("concert")
}

model ConcertLineupEntry {
  id        String            @id @default(cuid())
  concertId String
  name      String
  role      ConcertLineupRole @default(SUPPORT)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  concert   Concert           @relation(fields: [concertId], references: [id], onDelete: Cascade)

  @@index([concertId, sortOrder])
  @@map("concert_lineup_entry")
}

model ConcertImage {
  id        String           @id @default(cuid())
  concertId String
  kind      ConcertImageKind @default(GALLERY)
  url       String
  alt       String?
  caption   String?
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  concert   Concert          @relation(fields: [concertId], references: [id], onDelete: Cascade)

  @@index([concertId, kind, sortOrder])
  @@map("concert_image")
}

model BookingRequest {
  id            String               @id @default(cuid())
  status        BookingRequestStatus @default(NEW)
  source        BookingRequestSource @default(PUBLIC_SITE)
  name          String
  email         String
  organization  String?
  eventType     String?
  city          String?
  venueCapacity String?
  requestedDate DateTime?
  budgetLabel   String?
  message       String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, createdAt])
  @@map("booking_request")
}

model NewsletterSubscriber {
  id             String                     @id @default(cuid())
  email          String                     @unique
  status         NewsletterSubscriberStatus @default(PENDING)
  source         String?
  subscribedAt   DateTime                   @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status, subscribedAt])
  @@map("newsletter_subscriber")
}
